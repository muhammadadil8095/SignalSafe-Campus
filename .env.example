# ============================================================
# SignalSafe Campus — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env files to version control.
# ============================================================

# ----- Backend (server-side only) -----

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose in frontend

# LLM / AI
LLM_API_KEY=your-llm-api-key                      # NEVER expose in frontend

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token         # NEVER expose in frontend

# Backend server
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ----- Frontend (browser-safe, prefixed with VITE_) -----

VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

